# Immutable cross-machine contract: A100 training -> Vitis AI 2.0 / U250.
PROJECT_ROOT=/datastore/icc_fce/resnet_paper

# Python must match exactly on both sides.
PYTHON_VERSION=3.6.8

# Framework API/topology versions must match exactly.
TORCH_BASE_VERSION=1.8.0
TORCHVISION_BASE_VERSION=0.9.0
TORCHAUDIO_BASE_VERSION=0.8.0
NUMPY_VERSION=1.19.5
PILLOW_VERSION=8.4.0

# A100 build (training).
A100_TORCH_VERSION=1.8.0+cu111
A100_TORCHVISION_VERSION=0.9.0+cu111
A100_CUDA_RUNTIME=11.1

# U250 quantization build (CPU host).
# The +cpu build suffix differs by hardware backend, while the PyTorch API/base
# version remains exactly 1.8.0 and torchvision remains 0.9.0.
U250_TORCH_VERSION=1.8.0+cpu
U250_TORCHVISION_VERSION=0.9.0+cpu

# Vitis AI compiler/quantizer contract.
VITIS_AI_RELEASE=2.0
VITIS_AI_GIT_TAG=v2.0
VITIS_AI_GIT_COMMIT=d02dcb6

MODEL_IMPL=torchvision.models.resnet101(pretrained=False)
NUM_CLASSES=100
INPUT_SHAPE=1,3,224,224
CHECKPOINT_FORMAT=CPU_STATE_DICT
CHECKPOINT_LOAD_POLICY=STRICT_TRUE
TRAIN_POLICY=TRAIN_ONCE
